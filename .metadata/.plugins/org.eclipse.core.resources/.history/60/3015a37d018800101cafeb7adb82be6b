package baekjoon_250903;

import java.util.Scanner;

public class No11654 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		String str = sc.next();
		char b = str.charAt(0);

		if (b < 10) {
			System.out.println(b+48);
		} else {
			System.out.println(b);
		}
		
		sc.close();

	}

}
