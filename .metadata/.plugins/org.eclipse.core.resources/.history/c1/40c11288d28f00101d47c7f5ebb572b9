package baekjoon_250911;

import java.util.Scanner;

public class No2941 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int num=0;
		String str = sc.next();
		
		while (str.length() >= 3) {
			switch (str.substring(0,3)) {
				case "dz=": num += 1; str = str.substring(3);
			}
		
			switch (str.substring(0,2)) {
				case "c=", "c-", "d-", "lj", "nj", "s=", "z=": num += 1; str = str.substring(2);
				default : num += 1; str = str.substring(1);
			}
		}
		
		if (str.equals("c=") || str.equals("c-") || str.equals("d-") || str.equals("lj") || str.equals("nj") ||
			str.equals("s=") || str.equals("z=")) {
			num += 1; System.out.println(num);
		} else if (str.length() == 2) {
			System.out.println(num+2);
		} else {System.out.println(num+1);}
		
		
		sc.close();

	}

}
