package baekjoon_250913;

import java.io.*;

public class No1316 {
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		int num = 0;
		boolean bl1=true, bl2=false;
		int n = Integer.parseInt(br.readLine());
		
		for (int i=0; i < n; i++) {
			String str = br.readLine();
			if (str.length() == 1 || str.length() == 2) {num += 1; continue;}
			
			for (int j=0; j < str.length()-2; j++) {
				int k = j+1;
				while (k < str.length()-1) {
					if (str.charAt(j) != str.charAt(k)) {k++; bl1=false; break;}
					k++;
				}
				
				while (k<str.length()) {
					if (str.charAt(j) == str.charAt(k)) {bl2 = true; break;}
					k++;
				}
				
				if (bl1 == false && bl2 == true) {break;}
			} // 한 단어 판정 완료
			
			
			if (bl1 == false && bl2 == true) {}
			else {num+=1;}
		}
		System.out.println(num);
	}
}
