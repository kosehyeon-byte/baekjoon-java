package baekjoon_250906;

import java.util.Scanner;

public class No2444 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		for (int i=0; i < n; i++) {
			for (int j=0; j<n-i-1; j++) {
				System.out.print(" ");
			}
			
			for (int k=0; k<(2*(i+1)-1); k++) {
				System.out.print("*");
			}
			
			for (int m=0; m<n-i-1; m++) {
				System.out.print(" ");
			}
			
			System.out.println();
		}
		
		for (int i=3; i >= 0; i--) {
			for (int j=0; j<n-i-1; j++) {
				System.out.print(" ");
			}
			
			for (int k=0; k<(2*(i+1)-1); k++) {
				System.out.print("*");
			}
			
			for (int m=0; m<n-i-1; m++) {
				System.out.print(" ");
			}
			
			System.out.println();
		}
		
		sc.close();

	}

}
