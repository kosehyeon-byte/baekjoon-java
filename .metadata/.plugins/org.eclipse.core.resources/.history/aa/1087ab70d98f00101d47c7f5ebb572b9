package baekjoon_250911;

import java.util.Scanner;

public class No2941 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int num=0;
		String str = sc.next();
		
		if (str.charAt(0) == 'c') {
			if (str.charAt(1) == '=' || str.charAt(1) == '-') {
				num += 1;
				str=str.substring(2);
			}
		}
		
		if (str.charAt(0) == 'd') {
			if (str.substring(1,3).equals("z=")) {
				num += 1;
				str=str.substring(3);
			} else if (str.charAt(1) == '-') {
				num += 1;
				str=str.substring(2);
			}
		}
		
		if (str.substring(0,2).equals("lj") || str.substring(0,2).equals("nj") || str.substring(0,2).equals("s=") || str.substring(0,2).equals("z="))
		{
			num += 1;
			str=str.substring(2);
		}
		
		System.out.println(num);
		
		sc.close();

	}

}
